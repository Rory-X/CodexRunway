<Window x:Class="CodexRunway.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexRunway"
        Width="360" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown">

  <!-- A tray flyout, not a normal window: no chrome, no taskbar entry, dismissed by
       clicking away (Deactivated) or pressing Escape. -->

  <Border Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource DividerBrush}"
          BorderThickness="1"
          CornerRadius="10"
          Margin="8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="Black" />
    </Border.Effect>

    <Grid Margin="14,12,14,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <DockPanel Grid.Row="0" LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="CodexRunway"
                   Style="{StaticResource TitleText}" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="Refresh"
                Style="{StaticResource QuietButton}" Click="OnRefreshClicked" />
      </DockPanel>

      <!-- Status line: says why the panel is empty, rather than just being empty. -->
      <TextBlock Grid.Row="1" x:Name="StatusText" Style="{StaticResource SubtitleText}"
                 Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

      <!-- Account list. Virtualising keeps a large account list cheap. -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
        <StackPanel>
          <TextBlock x:Name="AccountsHeader" Text="Accounts" Style="{StaticResource SectionHeader}" />
          <ItemsControl x:Name="AccountList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                        Padding="8,6" Margin="0,1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <DockPanel LastChildFill="True">
                        <Border x:Name="ActiveDot" DockPanel.Dock="Left"
                                Width="6" Height="6" CornerRadius="3"
                                Background="{StaticResource AccentBrush}"
                                Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleText" Text="{Binding Title}"
                                   Style="{StaticResource TitleText}" />
                      </DockPanel>
                      <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}"
                                 Style="{StaticResource SubtitleText}" Margin="12,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="QuotaText" Text="{Binding QuotaSummary}"
                                 Style="{StaticResource SubtitleText}"
                                 HorizontalAlignment="Right" />
                      <Button x:Name="SwitchButton" Content="Switch"
                              Style="{StaticResource QuietButton}"
                              Margin="0,2,0,0" HorizontalAlignment="Right"
                              Click="OnSwitchClicked" />
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <!-- Tone drives colour, so the rule lives in one place in the
                       presentation layer and the view only maps it. -->
                  <DataTrigger Binding="{Binding Tone}" Value="Active">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Tone}" Value="Problem">
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource ProblemBrush}" />
                    <Setter TargetName="ActiveDot" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Tone}" Value="Caution">
                    <Setter TargetName="QuotaText" Property="Foreground" Value="{StaticResource CautionBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="ActiveDot" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="EmptyText" Style="{StaticResource SubtitleText}"
                     Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,10,0,0">
        <TextBlock x:Name="FooterText" DockPanel.Dock="Left"
                   Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" x:Name="QuitButton" Content="Quit"
                Style="{StaticResource QuietButton}" Click="OnQuitClicked" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
