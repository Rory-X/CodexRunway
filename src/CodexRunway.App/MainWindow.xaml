<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexRunway.App"
        xmlns:vm="clr-namespace:CodexRunway.Presentation;assembly=CodexRunway.Presentation"
        x:Class="CodexRunway.App.MainWindow"
        Title="CodexRunway"
        Width="380" Height="600"
        MinWidth="340" MinHeight="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

  <!-- A tray flyout in spirit, but a real window on Windows: no chrome, rounded, and
       dismissed with Escape. Windows has no anchored popover, so this is the honest
       equivalent rather than an imitation. -->

  <Window.Resources>
    <local:HealthToBrushConverter x:Key="HealthToBrush" />
    <local:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
    <local:PlanBadgeConverter x:Key="PlanBadge" />
    <local:HealthKeyToBrushConverter x:Key="HealthKeyToBrush" />
  </Window.Resources>

  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="{StaticResource HairlineBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource RadiusCard}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5" Color="Black" />
    </Border.Effect>

    <DockPanel LastChildFill="True">

      <!-- Header: draggable, because the window has no title bar. -->
      <Grid DockPanel.Dock="Top" Height="40" Background="Transparent"
            MouseLeftButtonDown="OnHeaderDrag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="14,0,0,0">
          <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" />
          <TextBlock Text="CodexRunway" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="0,0,8,0">
          <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource QuietButton}"
                  Click="OnRefreshClicked" />
          <Button x:Name="UpdateButton" Content="检查更新" Style="{StaticResource QuietButton}"
                  Click="OnCheckUpdateClicked" />
          <Button x:Name="MinimizeButton" Content="–" Style="{StaticResource QuietButton}"
                  Click="OnMinimizeClicked" />
          <Button x:Name="CloseButton" Content="✕" Style="{StaticResource QuietButton}"
                  Click="OnCloseClicked" />
        </StackPanel>
      </Grid>

      <!-- Status strip: shown only when there is something to say. -->
      <Border DockPanel.Dock="Top" x:Name="StatusPanel" Margin="14,0,14,6" Padding="9,6"
              CornerRadius="{StaticResource RadiusRow}"
              Background="{StaticResource SurfaceRaisedBrush}"
              Visibility="Collapsed">
        <TextBlock x:Name="StatusText" FontSize="10.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" />
      </Border>

      <!-- Footer -->
      <Grid DockPanel.Dock="Bottom" Margin="14,8,14,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="FooterText" FontSize="10"
                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" x:Name="CountText" FontSize="10"
                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
      </Grid>

      <!-- Accounts.
           The active account gets a full card; everything else gets one line, grouped by kind.
           Twelve identical cards came to a very long page and buried the one row a user opens
           the panel to see. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,0"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,0,14,0">

          <!-- Accounts needing action come first: they are the reason to open the panel. -->
          <ItemsControl x:Name="AttentionList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:AccountRow}">
                <Border CornerRadius="{StaticResource RadiusCard}" Margin="0,0,0,8"
                        Padding="12,11" Background="#14FF9F0A" BorderBrush="#33FF9F0A"
                        BorderThickness="1">
                  <StackPanel>
                    <DockPanel LastChildFill="True">
                      <Border DockPanel.Dock="Right" Padding="5,1" CornerRadius="4"
                              VerticalAlignment="Center" Background="{StaticResource TagOrangeBackground}">
                        <TextBlock Text="需重新授权" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TagOrangeForeground}" />
                      </Border>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}"
                                 VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="登录授权已失效，重新登录后恢复。" Margin="0,4,0,0"
                               Style="{StaticResource SubtitleText}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The active account. -->
          <ItemsControl x:Name="ActiveList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:AccountRow}">
                <Border CornerRadius="{StaticResource RadiusCard}" Margin="0,0,0,4"
                        Padding="14,13" Background="#0E0A84FF"
                        BorderBrush="#6B0A84FF" BorderThickness="1">
                  <StackPanel>
                    <!-- Title row: name, plan chip, current chip -->
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                  VerticalAlignment="Center">
                        <Border Padding="5,1" CornerRadius="4" Margin="4,0,0,0"
                                Background="{StaticResource TagBlueBackground}"
                                Visibility="{Binding PlanType, Converter={StaticResource NotEmpty}}">
                          <TextBlock Text="{Binding PlanType, Converter={StaticResource PlanBadge}}"
                                     FontSize="9.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource TagBlueForeground}" />
                        </Border>
                        <Border Padding="5,1" CornerRadius="4" Margin="4,0,0,0"
                                Background="{StaticResource TagGreenBackground}">
                          <TextBlock Text="当前" FontSize="9.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource TagGreenForeground}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="{Binding WorkspaceLine}" Margin="0,3,0,0"
                               Style="{StaticResource SubtitleText}"
                               Visibility="{Binding HasWorkspace, Converter={StaticResource NotEmpty}}" />

                    <!-- Expiry, only inside the warning window -->
                    <Border Margin="0,7,0,0" Padding="6,2" CornerRadius="4"
                            HorizontalAlignment="Left"
                            Background="{StaticResource TagOrangeBackground}"
                            Visibility="{Binding HasExpiryNotice, Converter={StaticResource NotEmpty}}">
                      <TextBlock Text="{Binding ExpiryNotice}" FontSize="10.5"
                                 Foreground="{StaticResource TagOrangeForeground}" />
                    </Border>

                    <!-- One block per quota window -->
                    <ItemsControl ItemsSource="{Binding Quota.Windows}" Margin="0,10,0,0"
                                  Visibility="{Binding HasQuota, Converter={StaticResource NotEmpty}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuotaWindowView}">
                          <Grid Margin="0,0,0,6">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}"
                                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding RemainingPercent, StringFormat={}{0}%}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{Binding Health, Converter={StaticResource HealthToBrush}}" />

                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                         Style="{StaticResource QuotaBar}"
                                         Value="{Binding RemainingPercent, Mode=OneWay}"
                                         Foreground="{Binding Health, Converter={StaticResource HealthToBrush}}"
                                         Visibility="{Binding ShowBar, Converter={StaticResource NotEmpty}}" />

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ResetLabel}"
                                       FontSize="10.5" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Visibility="{Binding ResetLabel, Converter={StaticResource NotEmpty}}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="尚无配额数据" FontSize="10.5" Margin="0,8,0,0"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Visibility="{Binding NeedsQuotaNotice, Converter={StaticResource NotEmpty}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Subscription accounts -->
          <TextBlock x:Name="SubscriptionHeader" Text="订阅账号"
                     Style="{StaticResource SectionHeader}" Margin="2,14,0,6"
                     Visibility="{Binding HasOtherSubscriptionAccounts, Converter={StaticResource NotEmpty}}" />
          <Border x:Name="SubscriptionListFrame" CornerRadius="{StaticResource RadiusCard}"
                  Background="{StaticResource SurfaceRaisedBrush}"
                  BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                  Visibility="{Binding HasOtherSubscriptionAccounts, Converter={StaticResource NotEmpty}}">
            <ItemsControl x:Name="SubscriptionList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AccountRow}">
                  <Grid Margin="0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.ColumnSpan="2" Grid.Row="0" Height="1"
                            Background="{StaticResource HairlineFaintBrush}"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowDivider, Converter={StaticResource NotEmpty}}" />

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="13,10,0,10">
                      <TextBlock Text="{Binding Title}" FontSize="12.5"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 VerticalAlignment="Center" />
                      <Border Padding="5,1" CornerRadius="4" Margin="7,0,0,0"
                              VerticalAlignment="Center"
                              Background="{StaticResource TagBlueBackground}"
                              Visibility="{Binding PlanType, Converter={StaticResource NotEmpty}}">
                        <TextBlock Text="{Binding PlanType, Converter={StaticResource PlanBadge}}"
                                   FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TagBlueForeground}" />
                      </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,10,13,10" VerticalAlignment="Center">
                      <TextBlock Text="{Binding CompactQuotaText}" FontSize="12.5" FontWeight="SemiBold"
                                 HorizontalAlignment="Right"
                                 Foreground="{Binding CompactQuotaBrushKey, Converter={StaticResource HealthKeyToBrush}}" />
                      <TextBlock Text="{Binding CompactResetText}" FontSize="10" Margin="0,2,0,0"
                                 HorizontalAlignment="Right"
                                 Foreground="{StaticResource TextTertiaryBrush}"
                                 Visibility="{Binding CompactResetText, Converter={StaticResource NotEmpty}}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- Relay accounts -->
          <TextBlock x:Name="RelayHeader" Text="中转账号"
                     Style="{StaticResource SectionHeader}" Margin="2,14,0,6"
                     Visibility="{Binding HasRelayAccounts, Converter={StaticResource NotEmpty}}" />
          <Border x:Name="RelayListFrame" CornerRadius="{StaticResource RadiusCard}"
                  Background="{StaticResource SurfaceRaisedBrush}"
                  BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                  Visibility="{Binding HasRelayAccounts, Converter={StaticResource NotEmpty}}">
            <ItemsControl x:Name="RelayList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AccountRow}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.ColumnSpan="2" Height="1"
                            Background="{StaticResource HairlineFaintBrush}"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowDivider, Converter={StaticResource NotEmpty}}" />

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="13,10,0,10">
                      <TextBlock Text="{Binding Title}" FontSize="12.5"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 VerticalAlignment="Center" />
                      <Border Padding="5,1" CornerRadius="4" Margin="7,0,0,0"
                              VerticalAlignment="Center"
                              Background="{StaticResource TagNeutralBackground}">
                        <TextBlock Text="中转" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TagNeutralForeground}" />
                      </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding BalanceText}" FontSize="12.5"
                               FontWeight="SemiBold" Margin="0,10,13,10"
                               VerticalAlignment="Center"
                               Foreground="{Binding BalanceBrushKey, Converter={StaticResource HealthKeyToBrush}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <TextBlock x:Name="EmptyText" Style="{StaticResource SubtitleText}"
                     Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>
</Window>
