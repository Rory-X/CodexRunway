<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Mirrors the macOS app's RunwaySurface tokens instead of inventing a palette.

    The structural point: surfaces are translucent white overlays on the panel, not opaque
    greys. macOS builds them that way so one token works in both colour schemes and over a
    translucent popover; a hard-coded #26262E looks similar in a screenshot and wrong the
    moment the background changes. WPF brushes carry alpha, so the same approach is used here.

    Radii are the same numbers: control 5, row 6, card 10.
  -->

  <!-- Panel: sits under everything, so it is the one opaque surface. -->
  <SolidColorBrush x:Key="PanelBrush" Color="#FF1E1E22" />

  <!-- Raised (cards, rows): white 6.5% — the macOS dark-mode value. -->
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#14FFFFFF" />
  <!-- Sunken (progress tracks, wells): white 4.5%. -->
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0BFFFFFF" />
  <!-- Hover: white 9%. -->
  <SolidColorBrush x:Key="HoverNeutralBrush" Color="#17FFFFFF" />
  <SolidColorBrush x:Key="HoverAccentBrush" Color="#1F0A84FF" />

  <!-- Hairlines. macOS multiplies separatorColor's own alpha rather than replacing it. -->
  <SolidColorBrush x:Key="HairlineBrush" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="HairlineFaintBrush" Color="#14FFFFFF" />

  <!-- Text: label / secondaryLabel / tertiaryLabel. -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F2F5" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99EBEBF0" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#66EBEBF0" />

  <!-- Accent, matching the system accent the macOS build reads via Color.accentColor. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF" />

  <!--
    Quota health, matching QuotaHealth in the macOS build: remaining >= 50 green, >= 20
    yellow, else red. Named here so the thresholds stay in one place rather than being
    restated as colours in the view.
  -->
  <SolidColorBrush x:Key="HealthGreenBrush" Color="#FF32D74B" />
  <SolidColorBrush x:Key="HealthYellowBrush" Color="#FFFFD60A" />
  <SolidColorBrush x:Key="HealthRedBrush" Color="#FFFF453A" />

  <!-- Tag tints, from RunwayTagTone. -->
  <SolidColorBrush x:Key="TagBlueForeground" Color="#FF4C9FFF" />
  <SolidColorBrush x:Key="TagBlueBackground" Color="#264C9FFF" />
  <SolidColorBrush x:Key="TagPurpleForeground" Color="#FFBF5AF2" />
  <SolidColorBrush x:Key="TagPurpleBackground" Color="#26BF5AF2" />
  <SolidColorBrush x:Key="TagOrangeForeground" Color="#FFFF9F0A" />
  <SolidColorBrush x:Key="TagOrangeBackground" Color="#26FF9F0A" />
  <SolidColorBrush x:Key="TagNeutralForeground" Color="#99EBEBF0" />
  <SolidColorBrush x:Key="TagNeutralBackground" Color="#24FFFFFF" />

  <CornerRadius x:Key="RadiusControl">5</CornerRadius>
  <CornerRadius x:Key="RadiusRow">6</CornerRadius>
  <CornerRadius x:Key="RadiusCard">10</CornerRadius>

  <!-- ================================================================ typography -->

  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="SubtitleText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="6,0,0,5" />
  </Style>

  <!-- ================================================================ controls -->

  <Style x:Key="QuietButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource RadiusControl}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverNeutralBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Progress bar for a quota window. Track is sunken, fill is the health colour. -->
  <Style x:Key="QuotaBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="5" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Foreground" Value="{StaticResource HealthGreenBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="2.5" ClipToBounds="True">
            <Grid>
              <Rectangle x:Name="PART_Track" />
              <Rectangle x:Name="PART_Indicator"
                         Fill="{TemplateBinding Foreground}"
                         HorizontalAlignment="Left"
                         RadiusX="2.5" RadiusY="2.5" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
