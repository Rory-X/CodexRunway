<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodexRunway.Presentation"
        x:Class="CodexRunway.Desktop.Views.MainWindow"
        x:DataType="vm:PanelState"
        Title="CodexRunway"
        Width="380" Height="560"
        MinWidth="320" MinHeight="360"
        Background="{StaticResource SurfaceBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="38">

  <Window.Styles>
    <!-- Tone is computed once in the presentation layer; these selectors only map it onto
         colour, so the two platforms cannot disagree about what "caution" means. -->
    <Style Selector="Border.active">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    </Style>
    <Style Selector="Border.problem TextBlock.row-title">
      <Setter Property="Foreground" Value="{StaticResource ProblemBrush}" />
    </Style>
    <Style Selector="Border.caution TextBlock.row-quota">
      <Setter Property="Foreground" Value="{StaticResource CautionBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- Header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Height="38" Margin="14,0,8,0">
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
        <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" />
        <TextBlock Text="CodexRunway" FontWeight="SemiBold" FontSize="13"
                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button x:Name="RefreshButton" Content="Refresh" FontSize="11"
                Background="Transparent" Padding="7,3" />
        <Button x:Name="QuitButton" Content="Quit" FontSize="11"
                Background="Transparent" Padding="7,3" />
      </StackPanel>
    </Grid>

    <!-- Status line: present only when there is something to say. -->
    <Border DockPanel.Dock="Top" x:Name="StatusPanel" Margin="14,2,14,0" Padding="9,6"
            CornerRadius="6" Background="{StaticResource SurfaceRaisedBrush}"
            IsVisible="False">
      <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap"
                 Foreground="{StaticResource TextSecondaryBrush}" />
    </Border>

    <!-- Footer: when the data was read. -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="14,6,14,12">
      <TextBlock Grid.Column="0" x:Name="FooterText" FontSize="10.5"
                 Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="CountText" FontSize="10.5"
                 Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
    </Grid>

    <!-- Accounts -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,4,8,0">
      <StackPanel>
        <TextBlock x:Name="AccountsHeader" Text="ACCOUNTS" FontSize="10" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="7,6,0,5" />

        <ItemsControl x:Name="AccountList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AccountRow">
              <!-- Classes are bound to the row's state, so tone is expressed once here and
                   decided entirely by the presentation layer rather than re-derived in XAML. -->
              <Border Name="RowBorder" CornerRadius="7" Padding="9,7" Margin="0,1"
                      Background="Transparent"
                      Classes.active="{Binding IsActive}"
                      Classes.problem="{Binding IsProblem}"
                      Classes.caution="{Binding IsCaution}">
                <Grid ColumnDefinitions="Auto,*,Auto">

                  <!-- The active marker: present only on the account in use. -->
                  <Ellipse Grid.Column="0" Name="ActiveDot" Width="6" Height="6"
                           Fill="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           IsVisible="{Binding IsActive}" />

                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Name="RowTitle" Text="{Binding Title}" FontSize="12.5"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Classes="row-title"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Name="RowSubtitle" Text="{Binding Subtitle}" FontSize="10.5"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Name="RowQuota" Text="{Binding QuotaSummary}" FontSize="10.5"
                               HorizontalAlignment="Right" Classes="row-quota"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               IsVisible="{Binding HasQuotaSummary}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="EmptyText" FontSize="11" TextWrapping="Wrap" Margin="9,10,9,0"
                   Foreground="{StaticResource TextSecondaryBrush}" IsVisible="False" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
